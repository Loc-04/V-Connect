{
  "info": {
    "_postman_id": "8b9066e9-0fdf-46eb-9a1a-df9672db6b70",
    "name": "V-Connect Sprint 3 Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "volunteerAccessToken", "value": "" },
    { "key": "organizerAccessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "activityId", "value": "" },
    { "key": "registrationId", "value": "" },
    { "key": "volunteerUserId", "value": "" },
    { "key": "organizerUserId", "value": "" },
    { "key": "limit", "value": "10" }
  ],
  "item": [
    {
      "name": "Common",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Auth Me - Volunteer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{volunteerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.profile?.id) pm.collectionVariables.set('volunteerUserId', json.profile.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Auth Me - Organizer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.profile?.id) pm.collectionVariables.set('organizerUserId', json.profile.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registration API",
      "item": [
        {
          "name": "Register For Activity",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{volunteerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/activities/{{activityId}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "{{activityId}}", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  const registrationId = json.registration?.id || json.registration?.participationId || json.participation?.id || json.participation?.participationId;",
                  "  if (registrationId) pm.collectionVariables.set('registrationId', registrationId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Registration Detail - Volunteer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{volunteerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations/{{registrationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["registrations", "{{registrationId}}"]
            }
          }
        },
        {
          "name": "List Registrations By Activity - Organizer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/activities/{{activityId}}/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "{{activityId}}", "registrations"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (!pm.collectionVariables.get('registrationId') && Array.isArray(json.registrations) && json.registrations.length > 0) {",
                  "    const first = json.registrations[0];",
                  "    if (first?.id) pm.collectionVariables.set('registrationId', first.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cancel Registration",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{volunteerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/activities/{{activityId}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "{{activityId}}", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Approval API",
      "item": [
        {
          "name": "Approve Registration - Organizer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations/{{registrationId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["registrations", "{{registrationId}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Registration - Organizer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations/{{registrationId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["registrations", "{{registrationId}}", "reject"]
            }
          }
        },
        {
          "name": "Get Registration Detail - Organizer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations/{{registrationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["registrations", "{{registrationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Recommendation API",
      "item": [
        {
          "name": "Recommendations For Volunteer User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{volunteerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/{{volunteerUserId}}?limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "{{volunteerUserId}}"],
              "query": [
                { "key": "limit", "value": "{{limit}}" }
              ]
            }
          }
        },
        {
          "name": "Recommendations For Organizer User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/{{organizerUserId}}?limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "{{organizerUserId}}"],
              "query": [
                { "key": "limit", "value": "{{limit}}" }
              ]
            }
          }
        },
        {
          "name": "Recommendations For Activity",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/activity/{{activityId}}?limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "activity", "{{activityId}}"],
              "query": [
                { "key": "limit", "value": "{{limit}}" }
              ]
            }
          }
        },
        {
          "name": "Recommendations For Volunteer User - Admin",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations/{{volunteerUserId}}?limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations", "{{volunteerUserId}}"],
              "query": [
                { "key": "limit", "value": "{{limit}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}
