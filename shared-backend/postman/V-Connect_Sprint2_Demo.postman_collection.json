{
  "info": {
    "_postman_id": "a5e1c1cf-6e63-4f30-9c0c-0d1f0a2c5c8f",
    "name": "V-Connect Sprint 2 Demo (Seeded)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "activityId", "value": "" },
    { "key": "volunteerId", "value": "" },
    { "key": "organizerId", "value": "" },
    { "key": "limit", "value": "20" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth Me",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "Activity Detail (Spec /activity/:id)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/activity/{{activityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["activity", "{{activityId}}"]
        }
      }
    },
    {
      "name": "Participation History (Spec /participation-history)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/participation-history?limit={{limit}}",
          "host": ["{{baseUrl}}"],
          "path": ["participation-history"],
          "query": [
            { "key": "limit", "value": "{{limit}}" }
          ]
        }
      }
    },
    {
      "name": "Notifications - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/notifications?unread=true&limit={{limit}}",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"],
          "query": [
            { "key": "unread", "value": "true" },
            { "key": "limit", "value": "{{limit}}" }
          ]
        }
      }
    },
    {
      "name": "Notifications - Create (Admin/Organizer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{volunteerId}}\",\n  \"title\": \"Demo Notification\",\n  \"message\": \"Your demo activity has been approved.\",\n  \"type\": \"info\",\n  \"data\": { \"activityId\": \"{{activityId}}\" }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"]
        }
      }
    }
  ]
}
